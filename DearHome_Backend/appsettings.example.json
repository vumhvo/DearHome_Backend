{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=INTERIOR_SHOPPING;User Id=sa;Password=<db-password>;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "<random-secret-at-least-32-characters>",
    "Issuer": "http://localhost:5000/",
    "Audience": "http://localhost:5000/"
  },
  "Firebase": {
    "ApiKey": "<firebase-web-api-key>",
    "StorageBucket": "<project-id>.appspot.com",
    "CredentialPath": "Credentials/<firebase-adminsdk-service-account>.json"
  },
  "PayOS": {
    "BaseUrl": "https://api-merchant.payos.vn",
    "PAYOS_CLIENT_ID": "<payos-client-id>",
    "PAYOS_API_KEY": "<payos-api-key>",
    "PAYOS_CHECKSUM_KEY": "<payos-checksum-key>"
  },
  "Goship": {
    "BaseUrl": "<goship-api-base-url>",
    "ApiSecret": {
      "username": "<goship-username>",
      "password": "<goship-password>",
      "client_id": "<goship-client-id>",
      "client_secret": "<goship-client-secret>"
    }
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "<smtp-username>",
    "Password": "<smtp-app-password>",
    "FromEmail": "<from-email>",
    "FromName": "DearHome",
    "EnableSsl": "true"
  },
  "Redis": {
    "ConnectionString": "<redis-connection-string (Production only)>",
    "InstanceName": "DearHome_"
  },
  "ApplicationInsights": {
    "ConnectionString": "<application-insights-connection-string (optional)>"
  },
  "Nats": {
    "Url": "nats://localhost:4222",
    "Username": "<nats-username>",
    "Password": "<nats-password>",
    "ConnectionTimeout": 2000
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://<github-user>.github.io",
      "https://<firebase-project-id>.web.app",
      "https://<firebase-project-id>.firebaseapp.com"
    ]
  }
}
